ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/arima_executive_os
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_REFRESH_TOKEN_EXPIRE_HOURS=24
JWT_ISSUER=arima-executive-os
JWT_AUDIENCE=arima-executive-web
SECURITY_TOKEN_SECRET=replace-with-a-separate-long-random-secret
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
TRUSTED_PROXY_IPS=
PLATFORM_OPERATOR_USER_IDS=
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_NAME=arima_refresh_token
AUTH_CSRF_COOKIE_NAME=arima_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTRATION_RATE_LIMIT_PER_HOUR=10
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=5
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_CHANGE_TOKEN_EXPIRE_HOURS=24
EMAIL_PROVIDER=smtp
# SMTP_FROM_* are canonical. EMAIL_FROM_ADDRESS and EMAIL_FROM_NAME remain
# supported for existing deployments while those variables are migrated.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=local-user
SMTP_PASSWORD=local-password
SMTP_USE_TLS=false
SMTP_USE_SSL=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
LOG_LEVEL=INFO
DASHBOARD_CACHE_TTL_SECONDS=60
