ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/arima_executive_os
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_REFRESH_TOKEN_EXPIRE_HOURS=24
JWT_ISSUER=arima-executive-os
JWT_AUDIENCE=arima-executive-web
SECURITY_TOKEN_SECRET=replace-with-a-separate-long-random-secret
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
TRUSTED_PROXY_IPS=
PLATFORM_OPERATOR_USER_IDS=
# Comma-separated verified administrator emails allowed to use /admin/founder.
# Empty is deny-all; do not place this allowlist in frontend configuration.
FOUNDER_CONTROL_EMAILS=
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_NAME=arima_refresh_token
AUTH_CSRF_COOKIE_NAME=arima_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTRATION_RATE_LIMIT_PER_HOUR=10
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=5
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_CHANGE_TOKEN_EXPIRE_HOURS=24
# Resend is the production HTTPS email provider. SMTP remains an optional
# fallback when EMAIL_PROVIDER=smtp. Never commit provider credentials.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# SMTP_FROM_* are canonical sender variables shared by Resend and SMTP.
# EMAIL_FROM_ADDRESS and EMAIL_FROM_NAME remain supported for existing deployments.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
# Required only when EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
LOG_LEVEL=INFO
DASHBOARD_CACHE_TTL_SECONDS=60
# Server-only market data configuration. Twelve Data is the selected candidate,
# but prices remain unavailable until credentials, mappings, and customer-facing
# entitlements are separately verified. Never expose these values to a frontend.
MARKET_DATA_PROVIDER=twelve_data
MARKET_DATA_SOURCE=twelve_data
MARKET_DATA_ACCOUNT_PLAN=basic
MARKET_DATA_USAGE_SCOPE=internal_non_display
# These remain false until written commercial rights are approved. A credential
# alone is not entitlement. The reference is a server-side contract/approval ID.
MARKET_DATA_CUSTOMER_DISPLAY_ENTITLED=false
MARKET_DATA_REDISTRIBUTION_ENTITLED=false
MARKET_DATA_REAL_TIME_ENTITLED=false
MARKET_DATA_ENTITLEMENT_REFERENCE=
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
MARKET_DATA_XAUUSD_SYMBOL=XAU/USD
MARKET_DATA_XAUUSD_EXCHANGE=Commodity
MARKET_DATA_BTCUSD_SYMBOL=BTC/USD
MARKET_DATA_BTCUSD_EXCHANGE=Coinbase Pro
MARKET_DATA_SPX_SYMBOL=SPX
MARKET_DATA_SPX_EXCHANGE=CBOE
MARKET_DATA_STALE_AFTER_SECONDS=120
MARKET_DATA_TIMEOUT_SECONDS=5
MARKET_DATA_RATE_LIMIT_PER_MINUTE=8
